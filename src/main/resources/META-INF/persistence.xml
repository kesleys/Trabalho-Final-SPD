<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
  <persistence-unit name="vacinacao" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>br.ufg.inf.vacinacao.model.Vacina</class>
    <class>br.ufg.inf.vacinacao.model.Agenda</class>
    <class>br.ufg.inf.vacinacao.model.Alergia</class>
    <class>br.ufg.inf.vacinacao.model.Usuario</class>
    <class>br.ufg.inf.vacinacao.model.PeriodicidadeConverter</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <!-- Credenciais e política de esquema são fornecidas por ConfiguracaoBanco. -->
  </persistence-unit>
</persistence>
